# Copy to .env and fill in.

# From @BotFather → /newbot
BOT_TOKEN=

# Mini App URL (stays on GitHub Pages for now)
MINI_APP_URL=https://mugeshgithub.github.io/Ecla-market/

# Telegram chat id of the ECLA residents' group.
# Get it: add bot to group → send /id → copy the chat_id.
# Leave blank to disable group notifications.
GROUP_CHAT_ID=

# Comma-separated Telegram user ids allowed to run /announce and POST /api/announcements.
ADMIN_TELEGRAM_IDS=

# Public URL of this server in production (e.g. https://ecla-market.onrender.com).
# When set, bot uses webhook mode. When empty, long-polling (local dev).
PUBLIC_URL=

# LOCAL DEV ONLY — lets curl/Postman authenticate via a header instead of real initData.
# Never set in production.
ALLOW_DEV_AUTH=1

PORT=3000
DB_PATH=./ecla.db
